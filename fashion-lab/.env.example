# Firebase 연결에 필요한 값의 "이름"만 적어 둔 파일입니다.
# 내 컴퓨터에서 쓸 때: 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 실제 값을 채우세요.
# (.env 파일은 GitHub에 올라가지 않습니다. Netlify에는 사이트 설정 > Environment variables 에 같은 이름으로 넣습니다.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
